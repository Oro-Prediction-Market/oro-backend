# Redis
REDIS_URL=redis://localhost:2345

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_actual_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_username

# Database Configuration (existing)
DB_HOST=localhost
DB_PORT=1111
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=x_db
# Auto-create/alter tables from the entities on boot. LOCAL DEV ONLY — set to
# true so a fresh dev DB builds itself. Leave UNSET in production: the app
# force-disables it whenever NODE_ENV=production, and prod schema changes must
# go through reviewed migrations, never an automatic rewrite.
DB_SYNCHRONIZE=true

# Application Configuration (existing)
PORT=xxxx
FRONTEND_URL=http://localhost:1234
ADMIN_DEV_SECRET=your_admin_secret
ADMIN_TELEGRAM_ID=your_admin_telegram_id

# Security — Phone Hash
# HMAC-SHA-256 secret used to hash phone numbers before storing.
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')|0"
# NEVER change after go-live — existing phone hashes will become invalid.
PHONE_HASH_SECRET=replace_with_64_char_hex_secret

# JWT Configuration
# JWT
JWT_SECRET=replace_me_with_64_char_hex_secret
JWT_EXPIRES_IN=8h

# Football Data (football-data.org — free tier key)
FOOTBALL_DATA_API_KEY=your_api_key_here

# Telegram Mini App Configuration
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/bot/webhook
TELEGRAM_MINI_APP_URL=https://your-mini-app-url.com

# CORS — comma-separated list of allowed HTTPS frontend origins
# e.g. CORS_ORIGIN=https://your-app.vercel.app,https://t.me
CORS_ORIGIN=https://your-frontend-url.com

# Thin-pool guard — minimum unique bettors required for parimutuel settlement
# Markets below this threshold are refunded instead of settled
MIN_UNIQUE_BETTORS=2

# Reward paid to a correct lone challenger (admin overturned, no defenders),
# as a fraction of the market's house cut. 0.2 = 20% of the house cut
# (≈2% of the pool at a 10% edge). Clamped to [0, 1]; falls back to 0.2.
CHALLENGER_REWARD_HOUSE_CUT_FRACTION=0.2
# ── KYC document keys ────────────────────────────────────────────────────────
# Two separate secrets, deliberately. KYC_ENCRYPTION_KEY makes stored document
# numbers unreadable; KYC_INDEX_KEY makes them findable without being readable.
# Leaking one must not compromise the other, so never set them to the same
# value. Both are required before any document can be stored — the code refuses
# rather than degrading to plaintext or to an unsearchable row.
# Rotating either needs a re-encryption / re-index plan: existing rows become
# unreadable or unfindable otherwise.
KYC_ENCRYPTION_KEY=
KYC_INDEX_KEY=

# ── Google Sign-In ───────────────────────────────────────────────────────────
# OAuth 2.0 Web client ID from the Google Cloud console. Used as the audience
# when verifying ID tokens, so a token minted for a different application is
# rejected. Absent = the /auth/google route returns 503 and nothing else
# changes.
# The same value goes to the PWA as VITE_GOOGLE_CLIENT_ID; it is public by
# design.
GOOGLE_CLIENT_ID=

# Client SECRET for the same OAuth client. Required now that the branded button
# uses the popup / authorization-code flow: the backend exchanges the returned
# code for tokens (server-side) before verifying the ID token. Keep it secret —
# never ship it to the PWA. Absent = /auth/google's code flow returns 503.
GOOGLE_CLIENT_SECRET=

# ── USDT (TRC-20) via Twenty-one Pay ─────────────────────────────────────────
# Master switch. Anything other than "true" makes every USDT endpoint 503 and
# hides the rail from GET /api/payments/methods.
USDT_ENABLED=false

# Base URL MUST include the /v1 prefix — the client appends bare paths.
# Staging: https://dev-21pay.tech.bt/v1
# Must include the /v1 prefix. Without it every call lands on their SPA, which
# answers 404 with an HTML page rather than JSON — the request looks like a
# missing endpoint when it is a missing path segment.
TWENTYONE_PAY_BASE_URL=https://dev-21pay.tech.bt/v1
TWENTYONE_PAY_API_KEY=
TWENTYONE_PAY_TENANT_ID=

# Chains the client may pick from, comma-separated — only ones activated on the
# 21 Pay side. Supported: tron, base, polygon, arbitrum. An unrecognised value
# fails at boot rather than being skipped.
#
# There is deliberately NO default network. Every call names its chain, because
# a default is how a wrong-chain deposit happens: some path omits the network,
# the default fills in, and the user is handed a Tron address for a Base
# transfer. That send is unrecoverable.
TWENTYONE_PAY_NETWORKS=tron,base,polygon,arbitrum

# How long a deposit intent stays payable before it expires.
TWENTYONE_PAY_INTENT_TTL_MINUTES=30

# OPTIONAL — the rail works without it. Deposits credit via the client's poll of
# GET /usdt/intents/:id and the 2-minute reconciler sweep; a webhook only makes
# that faster. Left empty, the webhook endpoint returns 404 rather than
# accepting unsigned traffic on a public route.
# To enable: register https://<api-host>/api/payments/usdt/webhook with 21 Pay
# and paste the per-endpoint secret it shows once.
TWENTYONE_PAY_WEBHOOK_SECRET=

# Per-transaction deposit caps, in whole USDT
USDT_MIN_DEPOSIT=1
USDT_MAX_DEPOSIT=1000

# NOTE: USDT_ALLOW_CID_USERS has been removed. It gated Bhutan-resident accounts
# off the crypto rail under a design where one account could hold both BTN and
# USDT. Under currency segregation an account IS one currency or the other, so
# a BTN account has no crypto rail to be gated off — the currency does the
# gating structurally. Whether residents may hold a USDT account at all is a
# signup question, not a rail flag. See docs/usdt-oro/STAGE-G-ONBOARDING-KYC.md.

# ── Production ───────────────────────────────────────────────────────────────
# Nothing below is baked into the image — env in a Dockerfile ends up readable
# in the image layers, and the same image ships to every environment. They are
# injected as a Kubernetes Secret by .github/workflows/deploy.yaml.
#
# Set these in GitHub → Settings → Secrets and variables → Actions:
#
#   Secrets   GOOGLE_CLIENT_ID
#             MINIO_ENDPOINT / MINIO_ACCESS_KEY / MINIO_SECRET_KEY
#                                       — only needed when MinIO lives outside
#                                         the cluster; if it runs in the
#                                         `minio` namespace the deploy reads
#                                         its Secret directly, the same way it
#                                         does for Postgres and Redis.
#
#   Variables MINIO_ENDPOINT            (non-secret host:port, if you prefer)
#             MINIO_KYC_BUCKET          (defaults to oro-kyc)
#             MINIO_USE_SSL             (defaults to false)
#             TWENTYONE_PAY_BASE_URL    (must end in /v1 — the deploy refuses
#                                        otherwise, because without it every
#                                        call hits their web console and 404s)
#
# Deliberately NOT shipped to production:
#   KYC_ENCRYPTION_KEY, KYC_INDEX_KEY — without them the service refuses to
#   store an identity document at all, so KYC submission answers 503 there.
#   That is a safe state, not a broken one: nothing is written in the clear.
#   Add both (as two different values) on the day KYC goes live.
#
# The USDT rail needs, on top of the base URL:
#   Secrets   TWENTY_ONE_PAY_API             (bearer token for every call)
#             TWENTYONE_PAY_WEBHOOK_SECRET   (without it, deposits are only
#                                             credited by the 60s poller)
#   Variables TWENTYONE_PAY_NETWORKS         (e.g. tron,arbitrum,ethereum —
#                                             unset offers no chains at all)
#             USDT_ENABLED                   (defaults to false; going live
#                                             should be deliberate)
#
# Networks and the flag are not secrets, and should not be stored as ones:
# Actions masks a secret's literal value wherever it appears, so USDT_ENABLED
# would print as *** and "tron" would be blanked out of unrelated log lines.
# The deploy reads `vars` first and falls back to `secrets`, so either works.
#
# TWENTYONE_PAY_TENANT_ID is NOT needed — nothing in the code reads it. The
# API token already identifies the tenant.

# ── KYC document storage (MinIO) ─────────────────────────────────────────────
# Host:port or a full URL; MINIO_USE_SSL=true for https in the cluster.
#
# Images are encrypted with KYC_ENCRYPTION_KEY **before** they are uploaded, so
# the bucket only ever holds ciphertext — bucket credentials, a leaked backup,
# or a misconfigured public policy yield no readable passport. That is also why
# reviewers are served through /api/admin/kyc/image rather than a presigned
# link: a presigned URL would hand back ciphertext no browser can render.
#
# Leave these unset and uploads are refused outright. A deployment that takes a
# document and cannot store it is worse than one that says so at the door.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_KYC_BUCKET=oro-kyc
MINIO_USE_SSL=false
